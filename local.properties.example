## This file is a template for local.properties
# Copy this file to local.properties and fill in the actual values.
#
# This file should *NOT* be checked into Version Control Systems,
# as it contains information specific to your local configuration.
#
# Location of the SDK. This is only used by Gradle.
# Replace with your actual Android SDK path
sdk.dir=C\:\\Users\\YourUsername\\AppData\\Local\\Android\\Sdk

# Backend API Configuration
# Replace with your actual backend URL
BASE_URL=http://your-backend-url:port

# Yandex Maps API Key
# Get your API key from https://developer.tech.yandex.ru/
MAPKIT_API_KEY=your-yandex-maps-api-key-here
